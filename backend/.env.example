# Comma-separated allowed CORS origins — no trailing slashes
# Production example: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Terms are resolved at runtime from USC's /api/Terms/All -- there is no term
# code to maintain here. These only tune cache lifetimes.
# TERMS_CACHE_TTL=86400   # how long the active-term list is cached, seconds
# DEPT_CACHE_TTL=300      # how long a department catalog is cached, seconds
