# Backend API URL — set this in your Vercel environment variables dashboard
# No trailing slash
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Product analytics (PostHog). Leave empty to disable; nothing is sent without a key.
# Project settings > Project API key (public, safe to expose). Host: us or eu cloud.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
